{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "make show *": "allow",
      "make try *": "allow",
      "make verify": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "mkdir -p scratch/*": "allow",
      "cp * scratch/*": "allow"
    }
  }
}
